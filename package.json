{
  "name": "reserva-distribuidora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:loja": "vite --config vite.loja.config.js",
    "dev:admin": "vite --config vite.admin.config.js --port 5174",
    "build:loja": "vite build --config vite.loja.config.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "build": "npm run build:loja && npm run build:admin",
    "build:verificacao": "vite build --config vite.loja.config.js --mode verificacao && vite build --config vite.admin.config.js --mode verificacao",
    "verificar": "npm run segredos && npm run lint && npm test && npm run build:verificacao",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "segredos": "node scripts/verificar-segredos.mjs --tudo",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
