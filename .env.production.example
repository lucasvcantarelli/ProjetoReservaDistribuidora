# Copie este arquivo para .env.production e preencha antes de rodar `npm run build`.

# URL das Edge Functions do seu projeto Supabase (precisa ser https).
# Substitua <projeto> pelo "Reference ID" do projeto (Project Settings -> General).
VITE_FUNCTIONS_URL=https://<projeto>.supabase.co/functions/v1

# Pasta (dentro do seu site) em que o painel admin será publicado.
# Escolha um nome difícil de adivinhar; com barra no início e no fim.
VITE_ADMIN_BASE=/painel-x7k2q/
